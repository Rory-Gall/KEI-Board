{
  "name": "KEI Voice",
  "short_name": "KEI Voice",
  "description": "One button: tap, talk, and it goes to Claude.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#11171c",
  "theme_color": "#11171c",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "audio", "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".amr", ".3gp", ".ogg", ".opus", ".aac", ".webm"] }
      ]
    }
  }
}
